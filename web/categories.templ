// story: e05s01 e05s02 e08s06
package web

import "github.com/upareal/upareal/budget"

templ categoriesPage(groups []budget.Group, archived []budget.Category, errMsg string) {
	@layout("Categorias — upareal") {
		<p><a href="/">← Início</a></p>
		<h1>Categorias</h1>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		for _, g := range groups {
			<section class="group">
				<h2>
					<a href={ templ.SafeURL("/grupos/" + g.ID) }>{ g.Name }</a>
					<form method="post" action={ templ.SafeURL("/grupos/" + g.ID + "/mover?dir=up") } class="move"><button type="submit" aria-label="Mover grupo para cima">↑</button></form>
					<form method="post" action={ templ.SafeURL("/grupos/" + g.ID + "/mover?dir=down") } class="move"><button type="submit" aria-label="Mover grupo para baixo">↓</button></form>
				</h2>
				<ul>
					for _, c := range g.Categories {
						<li>
							<a href={ templ.SafeURL("/categorias/" + c.ID) }>{ c.Name }</a>
							<form method="post" action={ templ.SafeURL("/categorias/" + c.ID + "/mover?dir=up") } class="move"><button type="submit" aria-label="Mover para cima">↑</button></form>
							<form method="post" action={ templ.SafeURL("/categorias/" + c.ID + "/mover?dir=down") } class="move"><button type="submit" aria-label="Mover para baixo">↓</button></form>
						</li>
					}
				</ul>
				<form method="post" action="/categorias" class="inline">
					<input type="hidden" name="grupo" value={ g.ID }/>
					<label>Nova categoria <input name="nome" maxlength="100" required/></label>
					<button type="submit">Adicionar</button>
				</form>
			</section>
		}
		if len(archived) > 0 {
			<section class="group">
				<h2>Arquivadas</h2>
				<ul>
					for _, c := range archived {
						<li>
							{ c.Name }
							<form method="post" action={ templ.SafeURL("/categorias/" + c.ID + "/restaurar") } class="inline"><button type="submit">Restaurar</button></form>
						</li>
					}
				</ul>
			</section>
		}
		<section>
			<h2>Novo grupo</h2>
			<form method="post" action="/grupos" class="inline">
				<label>Nome <input name="nome" maxlength="100" required/></label>
				<label>
					Tipo
					<select name="tipo">
						<option value="expense">Despesas</option>
						<option value="income">Receitas</option>
					</select>
				</label>
				<button type="submit">Criar grupo</button>
			</form>
		</section>
	}
}

templ groupEditPage(g budget.Group, errMsg string) {
	@layout("Editar grupo — upareal") {
		<p><a href="/categorias">← Categorias</a></p>
		<h1>Editar grupo</h1>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		<form method="post" action={ templ.SafeURL("/grupos/" + g.ID) }>
			<label>Nome <input name="nome" value={ g.Name } maxlength="100" required/></label>
			<button type="submit">Salvar</button>
		</form>
	}
}

// categoryEditPage offers only groups of the same kind (B2).
templ categoryEditPage(c budget.Category, current budget.Group, sameKind []budget.Group, errMsg string) {
	@layout("Editar categoria — upareal") {
		<p><a href="/categorias">← Categorias</a></p>
		<h1>Editar categoria</h1>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		<form method="post" action={ templ.SafeURL("/categorias/" + c.ID) }>
			<label>Nome <input name="nome" value={ c.Name } maxlength="100" required/></label>
			<label>
				Grupo
				<select name="grupo">
					for _, g := range sameKind {
						<option value={ g.ID } selected?={ g.ID == current.ID }>{ g.Name }</option>
					}
				</select>
			</label>
			<button type="submit">Salvar</button>
		</form>
		<h2>Juntar com outra categoria</h2>
		<p class="muted">As contas, os valores planejados e o histórico desta categoria passam para a escolhida, e esta é arquivada.</p>
		<form method="post" action={ templ.SafeURL("/categorias/" + c.ID + "/juntar") } class="inline">
			<select name="destino" required>
				for _, g := range sameKind {
					<optgroup label={ g.Name }>
						for _, o := range g.Categories {
							if o.ID != c.ID {
								<option value={ o.ID }>{ o.Name }</option>
							}
						}
					</optgroup>
				}
			</select>
			<button type="submit">Juntar</button>
		</form>
		<h2>Arquivar</h2>
		<p class="muted">Só com Disponível zero no mês atual. As contas ligadas a ela ficam sem categoria.</p>
		<form method="post" action={ templ.SafeURL("/categorias/" + c.ID + "/arquivar") }>
			<button type="submit">Arquivar</button>
		</form>
	}
}

// story: e09s01 e09s02
package web

templ adminUsersPage(count string, rows []adminUserView, errMsg string) {
	@layout("Admin — upareal") {
		<p><a href="/">← Início</a></p>
		<h1>Usuários</h1>
		<p class="totals">{ count }</p>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		<table>
			<thead>
				<tr><th>Nome</th><th>Email</th><th>Cadastro</th><th>Último acesso</th><th></th></tr>
			</thead>
			<tbody>
				for _, u := range rows {
					<tr data-id={ u.ID }><td>{ u.Name }</td><td>{ u.Email }</td><td>{ u.CreatedAt }</td><td>{ u.LastSeenAt }</td>
						<td>
							if u.Admin {
								<span class="muted">admin</span>
							} else {
								if u.Disabled {
									<span class="negative">desativado</span>
									<form method="post" action={ templ.SafeURL("/admin/usuarios/" + u.ID + "/reativar") } class="inline"><button type="submit">Reativar</button></form>
								} else {
									<form method="post" action={ templ.SafeURL("/admin/usuarios/" + u.ID + "/desativar") } class="inline"><button type="submit">Desativar</button></form>
								}
								<form method="post" action={ templ.SafeURL("/admin/usuarios/" + u.ID + "/excluir") } class="inline">
									<label><input type="checkbox" name="confirmo" required/> confirmo</label>
									<button type="submit">Excluir</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p class="muted">Excluir apaga para sempre as contas, lançamentos e o orçamento da pessoa.</p>
	}
}

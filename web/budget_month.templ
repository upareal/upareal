// story: e05s03 e08s02 e08s03 e08s04 e12s01
package web

templ budgetMonthPage(v monthView, errMsg string) {
	@layout("Orçamento — upareal") {
		<p><a href="/">← Início</a></p>
		<h1>Orçamento</h1>
		<nav class="months">
			<a href={ templ.SafeURL("/orcamento?mes=" + v.Prev) }>← Mês anterior</a>
			<strong>{ v.Label }</strong>
			<a href={ templ.SafeURL("/orcamento?mes=" + v.Next) }>Próximo mês →</a>
		</nav>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		<p class="totals"><strong>A distribuir: { v.ToBeAssigned }</strong></p>
		<p class="totals">Despesas: { v.ExpenseTotal } · Receitas: { v.IncomeTotal }</p>
		for _, g := range v.Groups {
			<section class="group">
				<h2>{ g.Name } <span class="balance">{ g.Total }</span></h2>
				<ul>
					for _, row := range g.Rows {
						<li>
							<form method="post" action={ templ.SafeURL("/orcamento/" + v.Month + "/" + row.CategoryID) } hx-post={ "/orcamento/" + v.Month + "/" + row.CategoryID } hx-target="main" hx-select="main" hx-swap="outerHTML" class="inline">
								<label>{ row.Name } <input name="valor" value={ row.Value } inputmode="decimal" required/></label>
								<button type="submit">Salvar</button>
							</form>
							if row.Income {
								<span class="muted">Recebido { row.Received }</span>
							} else {
								if row.CarryOver != "" {
									<span class={ templ.KV("negative", row.CarriedOverspent) }>Do mês anterior { row.CarryOver }</span>
								}
								<span class="muted">Gasto { row.Spent }</span>
								<span class={ templ.KV("negative", row.Overspent) }>Disponível { row.Available }</span>
							}
						</li>
					}
				</ul>
			</section>
		}
		if len(v.Cards) > 0 {
			<section class="group">
				<h2>Cartões de crédito</h2>
				<p class="muted">O valor gasto no cartão já saiu das categorias e fica separado para pagar a fatura.</p>
				<ul>
					for _, c := range v.Cards {
						<li>{ c.Name } <span class="balance">Para pagar { c.Due }</span></li>
					}
				</ul>
				if v.Uncovered != "" {
					<p class="negative">Sem cobertura: { v.Uncovered }</p>
					<p class="muted">Seu dinheiro não cobre toda a fatura. Cubra as categorias negativas ou distribua menos.</p>
				}
			</section>
		}
		if v.UnmappedSpent != "" {
			<section class="group">
				<h2>Sem categoria</h2>
				<p>Gasto { v.UnmappedSpent } · Recebido { v.UnmappedReceived }</p>
				<p class="muted">Contas sem categoria e lançamentos a categorizar. <a href="/planejamento/mapa">Ligue as contas no Mapa</a> ou revise em <a href="/revisao">Revisão</a>.</p>
			</section>
		}
	}
}

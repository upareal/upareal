// story: e04s02 e04s03 e06s01
package web

templ accountsPage(sections []accountSection, archived []accountView, errMsg, today string) {
	@layout("Contas — upareal") {
		<p><a href="/">← Início</a></p>
		<h1>Contas</h1>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		for _, sec := range sections {
			<section class="accounts">
				<h2>{ sec.Title }</h2>
				if len(sec.Rows) == 0 {
					<p class="muted">Nenhuma conta.</p>
				}
				<ul>
					for _, a := range sec.Rows {
						<li>
							<strong><a href={ templ.SafeURL("/contas/" + a.ID) }>{ a.Name }</a></strong>
							<a href={ templ.SafeURL("/contas/" + a.ID + "/lancamentos") } class="tag">Lançamentos</a>
							<form method="post" action={ templ.SafeURL("/contas/" + a.ID + "/mover?dir=up") } class="move"><button type="submit" aria-label="Mover para cima">↑</button></form>
							<form method="post" action={ templ.SafeURL("/contas/" + a.ID + "/mover?dir=down") } class="move"><button type="submit" aria-label="Mover para baixo">↓</button></form>
							if a.IsCard {
								<span class="tag">Cartão</span>
							}
							if a.OffBudget {
								<span class="tag">Fora do orçamento</span>
							}
							if sec.Adjustable {
								<span class="balance">{ a.Balance }</span>
								<form method="post" action={ templ.SafeURL("/contas/" + a.ID + "/ajuste") } class="inline">
									<label>Saldo real <input name="saldo" inputmode="decimal" placeholder="1.234,56" required/></label>
									<button type="submit">Ajustar</button>
								</form>
							}
						</li>
					}
				</ul>
			</section>
		}
		if len(archived) > 0 {
			<section class="accounts">
				<h2>Arquivadas</h2>
				<ul>
					for _, a := range archived {
						<li>
							{ a.Name }
							<form method="post" action={ templ.SafeURL("/contas/" + a.ID + "/restaurar") } class="move"><button type="submit">Restaurar</button></form>
						</li>
					}
				</ul>
			</section>
		}
		<section id="nova-conta">
			<h2>Nova conta</h2>
			<form method="post" action="/contas">
				<label>Nome <input name="nome" maxlength="100" required/></label>
				<label>
					Tipo
					<select name="tipo">
						<option value="asset">Conta ou dinheiro</option>
						<option value="liability">Cartão ou dívida</option>
						<option value="income">Receita</option>
						<option value="expense">Despesa</option>
					</select>
				</label>
				<label>Saldo atual (ou valor devido) <input name="saldo" inputmode="decimal" placeholder="0,00"/></label>
				<label>Data <input type="date" name="data" value={ today }/></label>
				<label><input type="checkbox" name="orcamento" checked/> No orçamento</label>
				<label><input type="checkbox" name="cartao"/> É cartão de crédito</label>
				<button type="submit">Criar conta</button>
			</form>
		</section>
	}
}

// accountEditPage edits one account; the type is only changeable while unused (L5).
templ accountEditPage(a accountView, errMsg string) {
	@layout("Editar conta — upareal") {
		<p><a href="/contas">← Contas</a></p>
		<h1>Editar conta</h1>
		if errMsg != "" {
			<p class="error" role="alert">{ errMsg }</p>
		}
		<form method="post" action={ templ.SafeURL("/contas/" + a.ID) }>
			<label>Nome <input name="nome" value={ a.Name } maxlength="100" required/></label>
			<label>
				Tipo
				<select name="tipo">
					<option value="asset" selected?={ a.Type == "asset" }>Conta ou dinheiro</option>
					<option value="liability" selected?={ a.Type == "liability" }>Cartão ou dívida</option>
					<option value="income" selected?={ a.Type == "income" }>Receita</option>
					<option value="expense" selected?={ a.Type == "expense" }>Despesa</option>
				</select>
			</label>
			<label><input type="checkbox" name="orcamento" checked?={ !a.OffBudget }/> No orçamento</label>
			<label><input type="checkbox" name="cartao" checked?={ a.IsCard }/> É cartão de crédito</label>
			<button type="submit">Salvar</button>
		</form>
		<form method="post" action={ templ.SafeURL("/contas/" + a.ID + "/arquivar") } class="inline">
			<button type="submit">Arquivar</button>
		</form>
		<form method="post" action={ templ.SafeURL("/contas/" + a.ID + "/excluir") } class="inline">
			<button type="submit">Excluir</button>
		</form>
	}
}

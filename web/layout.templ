// story: e01s01 e03s01 e03s02 e03s03 e04s01 e04s02 e05s01 e05s03 e06s05 e07s01 e08s01 e09s01 e10s01
package web

// layout is the base page: pt-BR, mobile viewport, app CSS and vendored HTMX.
templ layout(title string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<main>
				{ children... }
			</main>
			<footer>
				<a href="/privacidade">Privacidade</a>
				<a href="/termos">Termos de Uso</a>
			</footer>
		</body>
	</html>
}

// homePage greets a signed-in user or offers Google sign-in.
templ homePage(signedIn bool, firstName string, admin bool) {
	@layout("upareal") {
		<h1>upareal</h1>
		if signedIn {
			if firstName != "" {
				<p>Olá, { firstName }!</p>
			} else {
				<p>Olá!</p>
			}
			<nav><a href="/orcamento">Orçamento</a> · <a href="/planejamento/mapa">Mapa</a> · <a href="/contas">Contas</a> · <a href="/categorias">Categorias</a> · <a href="/buscar">Buscar</a> · <a href="/revisao">Revisão</a> · <a href="/conta/dados">Meus dados</a>
				if admin {
					· <a href="/admin/usuarios">Admin</a>
				}
			</nav>
			<form method="post" action="/auth/logout">
				<button type="submit">Sair</button>
			</form>
			<form method="post" action="/auth/logout-all">
				<button type="submit">Sair de todos os dispositivos</button>
			</form>
		} else {
			<p>Seu orçamento pessoal, com cada real no lugar certo.</p>
			<p><a class="button" href="/auth/login">Entrar com Google</a></p>
		}
	}
}

// errorPage explains a failure in plain pt-BR and links back home.
templ errorPage(title, message string) {
	@layout(title + " — upareal") {
		<h1>{ title }</h1>
		<p>{ message }</p>
		<p><a href="/">Voltar ao início</a></p>
	}
}
